{"nodes": [{"id": "workflow_inor_fresh_driver_app", "label": "Inor Fresh Driver App Workflow", "file_type": "document", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1 title", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workflow_order_collection", "label": "Order Collection (Day 1)", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retailers place orders via Retailer App, WhatsApp, phone, or sales executives; all orders enter the ERP before a cut-off time so the Warehouse Head can plan routes with full visibility of demand."}, {"id": "workflow_warehouse_route_planning", "label": "Warehouse Route Planning", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A minimum of 10 retailers are assigned per vehicle and routes are optimized and assigned to drivers the previous night, to maximize vehicle capacity utilization and prepare drivers in advance."}, {"id": "workflow_erp", "label": "ERP System", "file_type": "document", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workflow_invoice_generation", "label": "Invoice Generation", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2 (ERP Integration Flow)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workflow_driver_login_authentication", "label": "Driver Login & Authentication", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Mobile OTP login and surfaces assigned vehicle details, assigned route, and day-wise orders so drivers start each day with a verified identity and a pre-planned route."}, {"id": "workflow_loading_verification", "label": "Loading Verification", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Driver verifies fish stock, ice, crates, and packaging materials before dispatch, with warehouse supervisor confirmation, to prevent incomplete or incorrect loads leaving the warehouse."}, {"id": "workflow_route_dashboard", "label": "Route Dashboard", "file_type": "document", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workflow_delivery_process", "label": "Delivery Process", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Driver records GPS and arrival time at each retailer location before delivering products, enabling location-verified delivery tracking."}, {"id": "workflow_delivery_confirmation", "label": "Delivery Confirmation", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confirmed via OTP or digital signature so ERP, inventory, and retailer systems can update automatically without manual reconciliation."}, {"id": "workflow_payment_collection", "label": "Payment Collection", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports cash, UPI, and bank transfer with driver-uploaded proof, so accounts update instantly and cash collection is improved."}, {"id": "workflow_damage_return_management", "label": "Damage & Return Management", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures return reason, photos, and quantity, classifying returns as replacement, credit note, or warehouse return to standardize how damaged/returned seafood is handled."}, {"id": "workflow_return_material_collection", "label": "Return Material Collection", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracks fish crates, ice boxes, thermocol boxes, and other returnable assets so reusable cold-chain equipment is not lost."}, {"id": "workflow_live_route_monitoring", "label": "Live Route Monitoring", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warehouse team monitors route completion, vehicle location, delays, and route deviations in real time to catch problems before they affect delivery SLAs."}, {"id": "workflow_cold_chain_monitoring", "label": "Cold Chain Monitoring", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records loading time, dispatch time, delivery time, and total transit duration to ensure cold-chain compliance for perishable seafood/fish products."}, {"id": "workflow_warehouse_return_process", "label": "Warehouse Return Process", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Driver returns with collected materials and returned products for reconciliation, closing the loop on assets and unsold/returned stock."}, {"id": "workflow_daily_closing_report", "label": "Daily Closing Report", "file_type": "document", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workflow_erp_integration_flow", "label": "ERP Integration Flow", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines the end-to-end system chain: Retailer Order -> ERP -> Route Planning -> Invoice Generation -> Driver Assignment -> Delivery Tracking -> Payment Collection -> Returns -> Warehouse Reconciliation -> Daily Reports, tying every workflow stage to a single automated pipeline."}, {"id": "workflow_strategic_benefits", "label": "Strategic Benefits", "file_type": "rationale", "source_file": "backend/src/config/Inor_Fresh_Driver_App_Workflow.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The overall system is designed to reduce delivery leakage, improve cold-chain compliance, track returnable assets, improve cash collection, and give end-to-end seafood supply chain visibility."}], "edges": [{"source": "workflow_inor_fresh_driver_app", "target": "workflo